# ─── Stage 1: Build ──────────────────────────────────────────────────────────
# Uses arm32v7/node so that native modules (e.g. bcrypt) compile for armv7.
# Build with: docker buildx build --platform linux/arm/v7 -f Dockerfile.armv7 ...
FROM arm32v7/node:22-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download pre-built Prisma engines for armv7 from lazarh/prisma-engine.
# The archive is a flat tar.gz (all binaries at root level).
# NOTE: libquery_engine_napi.so.node (NAPI/library mode) is NOT included in the
# release because it requires a working `prisma generate` on armv7 to produce.
# We force binary engine mode (engineType patched below) which only needs the
# standalone query-engine binary.
ARG PRISMA_ENGINES_VERSION=6.7.0
RUN mkdir -p /engines && \
    curl -fSL "https://github.com/lazarh/prisma-engine/releases/download/v${PRISMA_ENGINES_VERSION}/prisma-engines-${PRISMA_ENGINES_VERSION}-armv7.tar.gz" \
    | tar -xz -C /engines && \
    chmod +x /engines/query-engine /engines/migration-engine /engines/prisma-fmt

# Point Prisma at our pre-built engines BEFORE npm install so that postinstall
# scripts don't try to download unsupported armv7 engine binaries from the internet.
ENV PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
ENV PRISMA_QUERY_ENGINE_BINARY=/engines/query-engine
# Prisma v5+ renamed the migration engine env var; set both for compatibility.
ENV PRISMA_SCHEMA_ENGINE_BINARY=/engines/migration-engine
ENV PRISMA_MIGRATION_ENGINE_BINARY=/engines/migration-engine
ENV PRISMA_FMT_BINARY=/engines/prisma-fmt
# The Prisma CLI defaults to the *library* query engine; no armv7
# libquery_engine.so.node exists (binaries.prisma.sh 404s), so force the CLI
# into binary mode where PRISMA_QUERY_ENGINE_BINARY applies.
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=binary

COPY package.json package-lock.json* ./
RUN npm ci

COPY prisma ./prisma/
COPY . .

# Patch schema.prisma for armv7:
#  1. Remove linux-musl binaryTarget — no Prisma musl binary exists for armv7.
#  2. Add engineType = "binary" — avoids needing libquery_engine_napi.so.node
#     (NAPI library mode), using the standalone query-engine binary instead.
RUN sed -i \
      -e 's/binaryTargets = \["native", "linux-musl-openssl-3.0.x"\]/binaryTargets = ["native"]/' \
      -e '/provider\s*=\s*"prisma-client-js"/a\  engineType    = "binary"' \
      prisma/schema.prisma

RUN npx prisma generate
RUN npm run build


# ─── Stage 2: Production runner ──────────────────────────────────────────────
FROM arm32v7/node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
# Carry engine env vars into the runtime image so that prisma generate (below)
# and prisma migrate deploy (run at container START by the shared entrypoint)
# can locate the custom binaries — armv7 has no official Prisma engines, so
# the CLI must be pointed at the pre-baked /engines binaries at runtime too.
ENV PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
ENV PRISMA_QUERY_ENGINE_BINARY=/engines/query-engine
ENV PRISMA_SCHEMA_ENGINE_BINARY=/engines/migration-engine
ENV PRISMA_MIGRATION_ENGINE_BINARY=/engines/migration-engine
ENV PRISMA_FMT_BINARY=/engines/prisma-fmt
# See builder stage: CLI forced to binary engine mode — there is no armv7
# library query engine, and migrate deploy at container start runs via the CLI.
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=binary

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Bring pre-built engines from builder
COPY --from=builder /engines /engines

COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json* ./
# bcrypt ships no prebuilt binary for linux-arm, so npm compiles it here;
# the slim base has no Python/make/g++. Install build deps for this step only
# and purge them in the same layer (bcrypt's compiled binding stays in
# node_modules), keeping the runner slim.
# libssl3/openssl: all three custom armv7 Prisma engines link against
# libssl.so.3/libcrypto.so.3, which bookworm-slim does NOT ship — without it
# every engine dies at exec with "error while loading shared libraries:
# libssl.so.3" (first observed on the #18 board cutover: migrate deploy
# failed with an empty "Schema engine error"). Kept installed (marked
# manual, so the purge below cannot autoremove them).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ libssl3 openssl \
    && npm ci --omit=dev \
    && apt-get purge -y --auto-remove python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/prisma ./prisma/

RUN npx prisma generate
RUN mkdir -p /app/src/generated/prisma && chown -R nextjs:nodejs /app/src/generated/prisma

RUN chown -R nextjs:nodejs /app/prisma

COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder /app/next.config.ts ./next.config.ts

# Seed script and entrypoint (#11 decision): migrations + idempotent seed run
# at container START (not at image build), so they target the runtime
# DATABASE_URL. The image declares no DATABASE_URL default (and no file: DB
# fallback) — an unset/invalid DSN fails the container before the app starts.
# Shared with the main Dockerfile: same docker-entrypoint.sh, not an armv7 fork.
# Copied/owned by nextjs so the non-root user can run them.
COPY --from=builder --chown=nextjs:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nextjs:nodejs /app/docker-entrypoint.sh ./docker-entrypoint.sh

# Picture storage (#15/#16): compose mounts a volume at /app/data/pictures;
# pre-create it owned by the non-root app user so uploads and seed pictures
# can be written (a named volume inherits this ownership on first mount).
RUN mkdir -p /app/data/pictures && chown -R nextjs:nodejs /app/data/pictures

USER nextjs

EXPOSE 3000

# migrate deploy -> seed -> exec npm start
ENTRYPOINT ["/app/docker-entrypoint.sh"]
