# Familyverse dev stack configuration.
# Copy to `.env` to override — every variable already has a default in
# docker-compose.yml, so `docker compose up` works with NO .env at all.

# --- App ---
NEXTAUTH_URL=http://localhost:3000
# Generate a strong secret for anything non-dev: openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-nextauth-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Host-side URL (bare `npm run dev`, host `prisma` commands): Postgres is
# published on localhost:5432. Compose ignores this value and sets the
# container-internal URL (...@postgres:5432) in docker-compose.yml itself.
DATABASE_URL=postgresql://familyverse:familyverse@localhost:5432/familyverse?schema=public
# If you override these, keep the container URL in docker-compose.yml and
# this host-side URL in sync.
POSTGRES_USER=familyverse
POSTGRES_PASSWORD=familyverse
POSTGRES_DB=familyverse

# --- SMTP ---
# Host-side SMTP for bare `npm run dev` (MailHog's SMTP port is published on
# localhost). Compose ignores this value and talks to the `mailhog` service
# name directly.
# All SMTP_* vars are read by src/lib/mailer.ts (#20); unset or empty falls
# back to that file's compose defaults: host `mailhog`, port 1025, from
# no-reply@familyverse.local (host-side dev swaps the host for localhost).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@familyverse.local
# Optional TLS (#20): "true" = implicit TLS (SMTPS), "starttls" = require
# STARTTLS; empty/other = plaintext (MailHog).
SMTP_SECURE=
# Optional AUTH (#20): used only when BOTH are non-empty — leave blank for
# MailHog's open relay. Note compose currently forwards only HOST/PORT/FROM
# into the app container; host-side bare dev reads these directly.
SMTP_USER=
SMTP_PASS=

# --- Seed data (scripts/seed.mjs, runs on container start) ---
SEED_DEMO_EMAIL=demo@familyverse.local
SEED_DEMO_PASSWORD=demo123

# Picture storage root for host-side `npm run dev` (#15).
# In docker compose this is fixed to the container path /app/data/pictures.
PICTURES_DIR=./data/pictures
